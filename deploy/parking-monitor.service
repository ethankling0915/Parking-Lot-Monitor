[Unit]
Description=Parking lot monitor
After=network-online.target
Wants=network-online.target

[Service]
# Jetson user is team1. If the repo lives elsewhere, change WorkingDirectory and ExecStart to match.
User=team1
WorkingDirectory=/home/team1/parking-lot-monitor
ExecStart=/home/team1/parking-lot-monitor/.venv/bin/python -m parking_monitor.main --config config/config.yaml
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
